# Copy this file to .env and fill in real values.
# .env is gitignored -- never commit real credentials.

# =====================================================
# Auth0 setup (one-time, in the Auth0 dashboard)
# =====================================================
#
# 1. Sign up / log in at https://auth0.com and create a tenant
#    if you don't have one yet (free tier is fine for this).
#
# 2. Applications -> Create Application.
#      Name: anything (e.g. "Construction Intelligence")
#      Type: Regular Web Application  <-- must be this one,
#            not Single Page App or Machine to Machine.
#
# 3. In that application's Settings tab, copy:
#      Domain        -> AUTH0_DOMAIN below
#      Client ID     -> AUTH0_CLIENT_ID below
#      Client Secret -> AUTH0_CLIENT_SECRET below
#
# 4. Still in Settings, set (adjust the host/port if you run
#    uvicorn with a different --port):
#      Allowed Callback URLs: http://localhost:8000/callback
#      Allowed Logout URLs:   http://localhost:8000/
#    Save.
#
# 5. (Optional) Under Authentication -> Database, you can enable
#    "Disable Sign Ups" if this should be invite-only rather than
#    self-service signup.

AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# =====================================================
# Session cookie signing key
# =====================================================
#
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# Signs the session cookie so it can't be forged. Changing this
# invalidates all existing logins.

SESSION_SECRET_KEY=

# =====================================================
# App base URL
# =====================================================
#
# Must match what you run uvicorn on, and must match the
# callback/logout URLs registered in Auth0 above. No trailing
# slash.

APP_BASE_URL=http://localhost:8000

# Set to true only once this runs behind real TLS -- plain http
# can't send Secure cookies, so this must stay false for local dev.
SESSION_COOKIE_HTTPS_ONLY=false
